# Supabase (browser-safe keys only - set in Cloudflare Pages > Settings > Environment variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Server-only Supabase key for Worker writes (waitlist, checkout audit rows)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout (server-only values used by Cloudflare Pages Functions)
# Set these in Cloudflare Pages > Settings > Environment variables.
STRIPE_PRODUCT_ID=
STRIPE_NEBULA_PRICE_ID=
STRIPE_SUPERNOVA_PRICE_ID=
STRIPE_GALACTIC_PRICE_ID=
STRIPE_CUSTOM_PRICE_ID=
STRIPE_CUSTOM_MODE=payment
STRIPE_SECRET_KEY=
PUBLIC_SITE_URL=
