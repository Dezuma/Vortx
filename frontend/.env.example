# Supabase (browser-safe keys only - set in Cloudflare Pages > Settings > Environment variables)
# Encrypt local secrets with: ../../tools/bin/sops-env encrypt .env.local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Server-only Supabase key for Worker writes (waitlist, checkout audit rows)
SUPABASE_SERVICE_ROLE_KEY=
VORTX_ADMIN_EMAILS=
VORTX_ADMIN_BOOTSTRAP_EMAIL=
VORTX_ADMIN_BOOTSTRAP_PASSWORD=

# Stripe Checkout (server-only values used by Cloudflare Pages Functions)
# Set these in Cloudflare Pages > Settings > Environment variables.
STRIPE_PRODUCT_ID=
STRIPE_SCOUT_PRICE_ID=
STRIPE_SENTINEL_PRICE_ID=
STRIPE_NEBULA_PRICE_ID=
STRIPE_PULSAR_PRICE_ID=
STRIPE_SUPERNOVA_PRICE_ID=
STRIPE_GALACTIC_PRICE_ID=
STRIPE_CUSTOM_PRICE_ID=
STRIPE_CUSTOM_MODE=payment
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard → Developers → Webhooks → endpoint: https://vortxmkt.com/api/stripe-webhook
# Events: checkout.session.completed, customer.subscription.*, invoice.payment_failed

# Transactional email (Resend) — scan unlock + subscription welcome
RESEND_API_KEY=
SCAN_EMAIL_FROM=Vortx Scan <scan@vortxmkt.com>
SUBSCRIPTION_EMAIL_FROM=Vortx <billing@vortxmkt.com>
COURTLISTENER_API_TOKEN=
PACER_USERNAME=
PACER_PASSWORD=
# Production: https://vortxmkt.com
PUBLIC_SITE_URL=

# X marketing bot (server-only; set in root .dev.vars or Cloudflare Worker secrets)
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_OAUTH2_USER_TOKEN=
MARKETING_BOT_ENABLED=false
MARKETING_BOT_DRY_RUN=true
MARKETING_BOT_RUN_TOKEN=
MARKETING_CTA_URL=https://vortxmkt.com/?view=pricing
MARKETING_IMAGE_MODE=teaser-card
MARKETING_IMAGE_REQUIRED=false
MARKETING_CREATIVE_MODE=deterministic
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
OLLAMA_REQUIRED=false
