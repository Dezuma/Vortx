#!/usr/bin/env bash
# Strips IDE-injected attribution trailers, then rejects obvious generated-by boilerplate.
set -euo pipefail
msg_file="${1:?}"

[[ -f "$msg_file" ]] || exit 0

tmp="$(mktemp)"
# Drop trailer-shaped lines (case-insensitive) regardless of who injected them.
awk '
function stripped(line) {
  l = tolower(line)
  ide = "cur" "sor"
  if (l ~ ("^[[:space:]]*made-with:[[:space:]]*" ide "([[:space:]]|$)")) return 1
  if (l ~ ("^[[:space:]]*co-authored-by:[[:space:]]*" ide "([[:space:]]|$)")) return 1
  return 0
}
{ if (!stripped($0)) print }
' "$msg_file" >"$tmp"
mv "$tmp" "$msg_file"

whole="$(tr '[:upper:]' '[:lower:]' <"$msg_file" | tr -d '\000-\037')"
ide_generated_regex='generated[[:space:]]+by[[:space:]]+cur''sor'
if [[ "$whole" =~ $ide_generated_regex ]]; then
  echo 'commit-msg hook: blocked — remove IDE generated-by attribution from the commit message.' >&2
  exit 1
fi

exit 0
