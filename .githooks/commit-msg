#!/usr/bin/env bash
# Rejects commits whose message or trailers attribute work to Cursor or similar tooling.
set -euo pipefail
msg_file="${1:?}"

if [[ ! -f "$msg_file" ]]; then
  exit 0
fi

combined="$(tr '[:upper:]' '[:lower:]' < "$msg_file")"

deny_match() {
  local pattern="$1"
  local hint="$2"
  if grep -qiE "$pattern" <<< "$combined"; then
    echo "commit-msg hook: blocked — $hint" >&2
    echo "Remove Cursor/IDE attribution from the commit message and trailers, then commit again." >&2
    exit 1
  fi
}

deny_match 'made-with:[[:space:]]*cursor' 'disallowed trailer or text (made-with: cursor)'
deny_match 'generated[[:space:]]+by[[:space:]]+cursor' 'disallowed attribution (generated by cursor)'
deny_match 'co-authored-by:[[:space:]]*cursor' 'disallowed trailer (co-authored-by: cursor)'

exit 0
