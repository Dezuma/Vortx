{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vortx",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "cd frontend && npm ci && npm run build"
  },
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
