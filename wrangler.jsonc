    "STRIPE_CUSTOM_PRICE_ID": "price_1T5tBXRsNB149jDMLBCEMKYb",
    "STRIPE_CUSTOM_MODE": "payment"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
