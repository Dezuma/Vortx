{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vortx",
  "main": "./worker/index.js",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "cd frontend && npm ci && npm run build"
  },
  "assets": {
