{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vortx-marketing-bot",
  "main": "./worker/x-marketing-cron.js",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Single trigger (Cloudflare free plan: 5 crons per account, shared with
    // vortx-ingest-cron). The Worker expands per-day channel schedules itself.
    "crons": [
      "17 14 * * *"
    ]
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://vortxmkt.com",
    "VITE_SUPABASE_URL": "https://gejjtdrqyahajtijvghb.supabase.co",
    "MARKETING_CTA_URL": "https://vortxmkt.com/?view=pricing",
    "MARKETING_BOT_ENABLED": "true",
    "MARKETING_BOT_DRY_RUN": "false",
    "MARKETING_IMAGE_MODE": "teaser-card",
    "MARKETING_IMAGE_REQUIRED": "false",
    "MARKETING_CREATIVE_MODE": "playbook",
    "DISCORD_BOT_ENABLED": "true",
    "DISCORD_BOT_DRY_RUN": "false",
    "REDDIT_BOT_ENABLED": "false",
    "REDDIT_BOT_DRY_RUN": "true",
    "REDDIT_SUBREDDIT": "VortxUnredacted",
    "SUBSTACK_PUBLICATION_URL": "https://vortxmkt.substack.com",
    "SUBSTACK_MARKETING_DRAFT": "true",
    "SUBSTACK_MARKETING_PUBLISH": "false",
    "ANNOUNCE_ENABLED": "true",
    "LIVE_ALERTS_ENABLED": "true",
    "FACEBOOK_WEEKLY_ENABLED": "true",
    "FACEBOOK_WEEKLY_BRAND": "bybizu",
    "TWITCH_LOGIN": "bybizu_",
    "KICK_LOGIN": "bybizu",
    "BYBIZU_YOUTUBE_URL": "https://www.youtube.com/@ByBizu",
    "BYBIZU_TIKTOK_URL": "https://www.tiktok.com/@bybizu",
    "BYBIZU_KICK_URL": "https://kick.com/bybizu",
    "BYBIZU_TWITCH_URL": "https://www.twitch.tv/bybizu_",
    "FEMALESPACE_FACEBOOK_URL": "https://www.facebook.com/FemaleSpace1"
  }
}
